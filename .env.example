# ===================================================
# Configurações de Ambiente — Docker Wert
# Copie este arquivo para .env se desejar customizar
# ===================================================

# Portas de Acesso
APP_PORT=8080
DB_PORT_EXTERNAL=3307

# Credenciais do Banco MySQL
DB_NAME=wert
DB_USER=wert_user
DB_PASS=wert_secret_pass_123
DB_ROOT_PASS=wert_root_master_pass_123

# Integração com o Google Gemini (IA)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
