# ===================================================
# Configurações de Ambiente — Sistema Droma
# Modelo para configuração de Produção e Nuvem
# ===================================================

# Ambiente de Execução
APP_ENV=production

# Conexão com o Banco de Dados MySQL (TiDB Cloud, AWS RDS, etc.)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=wert
DB_USER=seu_usuario.root
DB_PASS=sua_senha_forte_do_banco

# Criptografia SSL no Banco de Dados (true para nuvem, false para local)
DB_SSL=true

# Integração com o Google Gemini (IA Assistente Financeiro)
GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui
GEMINI_MODEL=gemini-3.6-flash

# ===================================================
# Variáveis Opcionais para Docker Compose Local
# ===================================================
APP_PORT=8080
DB_PORT_EXTERNAL=3307
DB_ROOT_PASS=root_secret_pass_123
